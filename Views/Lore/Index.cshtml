@* Created by Nicholas Maddox *@
@model MvcEldenRingBossLore.Models.LoreTypeViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Lore</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form asp-controller="Lore" asp-action="Index" method="get">
    <p>

        <select asp-for="LoreType" asp-items="Model.Types">
            <option value="">All</option>
        </select>

        <label>Character: <input type="text" asp-for="SearchString" /></label>
        <label>Discovery Date: <input type="date" asp-for="DiscoveryDate" /></label>
        <input type="submit" value="Filter" />
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Lores![0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lores![0].DiscoveryDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lores![0].GodType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lores![0].Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lores!)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiscoveryDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GodType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Notes)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>