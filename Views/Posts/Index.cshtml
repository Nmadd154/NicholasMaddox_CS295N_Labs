@* Created by Nicholas Maddox *@
@model MvcEldenRingBossLore.Models.LoreTypeViewModel
@{
    ViewData["Title"] = "Posts";
}

<div class="text-center">
    <h1 class="display-4">Elden Ring Lore Posts</h1>
    <p>View and create posts about Elden Ring lore!</p>
    <br />
    <a class="btn btn-success btn-lg" asp-action="Create" role="button">Create New Post</a>
    <br /><br />
</div>

<form asp-controller="Posts" asp-action="Index" method="get">
    <p>
        <select asp-for="LoreType" asp-items="Model.Types">
            <option value="">All Types</option>
        </select>

        <label>Search: <input type="text" asp-for="SearchString" placeholder="Title, content, or author..." /></label>
        <label>Created Date: <input type="date" asp-for="CreatedDate" /></label>
        <input type="submit" value="Filter" class="btn btn-primary btn-sm" />
    </p>
</form>

@if (Model.Posts != null && Model.Posts.Any())
{
    <div class="container">
        @foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@post.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">by @post.Author | @post.CreatedAt.ToString("MMM dd, yyyy") | Type: @post.LoreType</h6>
                    <p class="card-text">@post.Content</p>
                    <p class="card-text"><small class="text-muted">Rating: @post.Rating</small></p>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-center">No posts yet. Be the first to create one!</p>
}